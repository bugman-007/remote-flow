# Remote Flow environment (OPS-2). Copy to deploy/.env and edit. Never commit real keys.

# --- public address -----------------------------------------------------------
# The URL browsers use; also drives CORS, cookie security and the Caddy site.
PUBLIC_URL=http://localhost:8080
# Domain Caddy serves (use :80 for plain HTTP on a private network).
SITE_ADDRESS=localhost
# Set true once Caddy serves HTTPS (AUTH-5 cookie flags).
COOKIE_SECURE=false
# Optional Let's Encrypt account email.
ACME_EMAIL=

# --- secrets ------------------------------------------------------------------
# openssl rand -base64 32  (store the copy you generate outside the server, NFR-6)
MASTER_KEY=
# openssl rand -hex 32
SECRET_KEY=
# openssl rand -hex 16
POSTGRES_PASSWORD=

# --- security -----------------------------------------------------------------
# SEC-9: optional comma-separated IPs/CIDRs allowed to use manager endpoints
# (empty = any network). Example: 10.0.0.0/8,192.168.1.20
MANAGER_IP_ALLOWLIST=

# --- pipeline tuning ----------------------------------------------------------
LLM_CONCURRENCY=16
RENDER_CONCURRENCY=1
# unoserver (default) | soffice | word | stub only for dev boxes without LibreOffice
RB_PDF_BACKEND=unoserver
CONTAINER_TZ=UTC
