# Remote Flow environment (OPS-2). Copy to deploy/.env and edit. Never commit real keys.

# --- public address -----------------------------------------------------------
# The URL browsers use; also drives CORS, cookie security and the Caddy site.
PUBLIC_URL=http://localhost:8080
# Domain Caddy serves (use :80 for plain HTTP on a private network).
SITE_ADDRESS=localhost
# Set true once Caddy serves HTTPS (AUTH-5 cookie flags).
COOKIE_SECURE=false
# Optional Let's Encrypt account email.
ACME_EMAIL=

# --- secrets ------------------------------------------------------------------
# openssl rand -base64 32  (store the copy you generate outside the server, NFR-6)
MASTER_KEY=
# openssl rand -hex 32
SECRET_KEY=
# openssl rand -hex 16
POSTGRES_PASSWORD=

# --- security -----------------------------------------------------------------
# SEC-9: optional comma-separated IPs/CIDRs allowed to use manager endpoints
# (empty = any network). Example: 10.0.0.0/8,192.168.1.20
MANAGER_IP_ALLOWLIST=

# --- pipeline tuning ----------------------------------------------------------
# runner (default): worker-llm is one async process with many provider calls in
# flight. celery: the old prefork pool (rollback; also set LLM_WORKER_MEM_LIMIT=3072m).
LLM_EXECUTOR=runner
# Most provider calls in flight at once on this server (runner); Settings -> Processors
# picks the number within it. ~310 MB for 150 measured.
LLM_RUNNER_MAX_CONCURRENCY=150
# Prefork pool range, only used with LLM_EXECUTOR=celery.
LLM_POOL_MIN=2
LLM_POOL_MAX=8
RENDER_CONCURRENCY=2
# unoserver (default) | soffice | word | stub only for dev boxes without LibreOffice
RB_PDF_BACKEND=unoserver
CONTAINER_TZ=America/New_York
